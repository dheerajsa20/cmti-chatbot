# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Leave empty for OpenAI. Only with faculty permission, a free OpenAI-compatible provider can be used instead:
#   Google Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  OPENAI_MODEL=gemini-2.5-flash
#   Groq:          OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.1-8b-instant
OPENAI_BASE_URL=
# Websites allowed to use the chat API from a browser (comma separated)
ALLOWED_ORIGINS=https://dheerajsa20.github.io,http://localhost:8000,http://127.0.0.1:8000
